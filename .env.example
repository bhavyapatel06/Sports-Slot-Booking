# Production mode disables predictable development starter credentials.
NODE_ENV=production

# Application/network
PORT=3000
# If the application is deployed behind a reverse proxy, configure the proxy
# to expose the application over HTTPS. The app itself does not require a
# public hostname.

# Initial administrator bootstrap (required only when the database has no users)
INITIAL_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
INITIAL_ADMIN_EMAIL=mail_id

# Email. In production, EMAIL_PROVIDER defaults to smtp.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.edu
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASS=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM=REPLACE_WITH_SMTP_USER
